<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 
    Livox MID-360 LiDAR Macro for magi_description
    
    Mount, in the IMU frame:
    - Position: (0.2580, 0, 0.0613) meters
    - Rotation: 0.08 rad (4.58 deg) of downward pitch about Y.
    
    NOTE: This macro uses the accurate MID-360 mesh (mid-360.dae).
    
    Usage:
      <xacro:include filename="$(find magi_description)/urdf/livox_mid360.xacro"/>
      <xacro:livox_mid360 parent="imu" name="livox_mid360"/>
  -->

  <xacro:macro name="livox_mid360" params="parent:=imu name:=livox_mid360">
    
    <!-- LiDAR Base Link (visual/collision) -->
    <link name="${name}_base">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.265"/>  <!-- MID-360 actual weight: ~265g -->
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0"
                 izz="0.0001"/>
      </inertial>
      
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 3.14159"/>
        <geometry>
          <mesh filename="package://magi_description/meshes/mid-360.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="livox_gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 3.14159"/>
        <geometry>
          <!-- Livox publishes the MID-360 as 65 x 65 x 60 mm. Upstream had
               86 x 86 x 42 here, which is 21 mm too wide and 18 mm too short. -->
          <box size="0.065 0.065 0.060"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint from parent (typically IMU) to LiDAR base -->
    <joint name="${name}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_base"/>
      <!--
        Transform from the IMU frame:
        - Translation: (0.2580, 0, 0.0613) meters, further forward and
          lower than the stock Go2 mount (0.1870, 0, 0.0803).
        - Rotation: 0.08 rad (4.58 deg) of downward pitch, against the stock
          mount's 13 deg. With the -7..+52 deg vertical FOV that puts the
          lowest ray 11.58 deg below horizontal, so the ground first appears
          about 2.7 m ahead of base at the nominal 0.40 m ride height.
      -->
      <origin xyz="0.2580 0 0.0613" rpy="0 0.08 0"/>
    </joint>

    <!-- LiDAR Optical Frame (sensor frame for point cloud) -->
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>
    </link>

    <!-- Joint from base to optical frame -->
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_base"/>
      <child link="${name}"/>
      <!-- 
        No additional transform needed - optical frame at sensor origin
        Livox drivers will publish point cloud in this frame
      -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
